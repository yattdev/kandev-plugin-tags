+const MAX_ICON_WRAPPER_DEPTH = 4;
+
+/**
+ * Whether a value is a function React can call as a component. A class
+ * constructor is a function too, but React cannot call one as a function
+ * component (`forwardRef` rejects a class outright at creation), so accepting
+ * it would move the failure into React's render -- `Class constructor X cannot
+ * be invoked without 'new'` -- where every caller of the resolver expects a
+ * glyph instead.
+ */
+function isRenderableFunction(value: unknown): boolean {
+  if (typeof value !== "function") return false;
+  return !/^\s*class[\s{]/.test(Function.prototype.toString.call(value));
+}
+
