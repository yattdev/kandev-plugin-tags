  * Whether a registration's icon is a plugin-owned component. React wraps
- * `forwardRef`, `memo` and `lazy` components in an object carrying a `$$typeof`
- * tag rather than a plain function, and `@tabler/icons-react` -- the set
+ * `forwardRef` and `memo` components in an object carrying a `$$typeof` tag
+ * rather than a plain function, and `@tabler/icons-react` -- the set
  * `PLUGIN_ICONS` maps names onto, and the icons plugins copy -- builds every
  * icon that way, so a guard that only tests `typeof icon === "function"`
  * rejects the most common component shape a bundle can send.
+ *
+ * Total by construction, because callers pass plugin data straight through: a
+ * getter that throws, a wrapper cycle, a forged tag, a `lazy` (which cannot
+ * resolve synchronously) and a class payload all answer `false` rather than
+ * throwing, so the resolver can fall back to a glyph anywhere it is used --
+ * nav, panels, drawers and integrations call it outside any try/catch.
  */
 export function isPluginIconComponent(icon: unknown): icon is PluginIconComponent {
-  if (typeof icon === "function") return true;
-  if (!icon || typeof icon !== "object") return false;
-  const tag = (icon as { $$typeof?: unknown }).$$typeof;
-  // Only the two tags that resolve synchronously: `lazy` cannot, so a menu
-  // icon built with it would leave the dropdown suspended or blank rather than
