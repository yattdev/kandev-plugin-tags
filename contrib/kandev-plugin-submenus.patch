@@ -0,0 +1,164 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { pluginRegistry } from "@/lib/plugins/registry";
+import type { PluginTaskMenuContext, TaskMenuSubItemRegistration } from "@/lib/plugins/types";
+import { buildPrimaryPluginEntries } from "./task-menu-actions";
+
+const PLUGIN_ID = "kandev-plugin-tags";
+const CONTEXT: PluginTaskMenuContext = {
+  workspaceId: "ws-1",
+  taskId: "task-1",
+  taskTitle: "Fix the bug",
+  workflowStepId: "step-1",
+  presentation: "desktop",
+};
+
+function register(
+  pluginId: string,
+  id: string,
+  label: string,
+  items?: (context: PluginTaskMenuContext) => unknown,
+) {
+  pluginRegistry.forPlugin(pluginId).registerTaskMenuAction({
+    id,
+    label,
+    group: "primary",
+    run: vi.fn(),
+    ...(items
+      ? {
+          items: items as (
+            context: PluginTaskMenuContext,
+          ) => readonly TaskMenuSubItemRegistration[],
+        }
+      : {}),
+  });
+}
+
+/** Every key the builder produced, parents and children alike. */
+function allKeys(): string[] {
+  return buildPrimaryPluginEntries({ context: CONTEXT }).flatMap((entry) =>
+    entry.kind === "submenu"
+      ? [entry.key, ...entry.children.map((child) => child.key)]
+      : [entry.key],
+  );
+}
+
+afterEach(() => {
+  pluginRegistry.unregisterPlugin(PLUGIN_ID);
+});
+
+describe("menu keys — distinct ids stay distinct", () => {
+  it("keeps a flat key and a child key apart when an id carries the delimiter", () => {
+    register(PLUGIN_ID, "quick#x", "Flat");
+    register(PLUGIN_ID, "quick", "Child holder", () => [{ id: "x", label: "Child", run: vi.fn() }]);
+
+    const keys = allKeys();
+
+    expect(keys).toEqual([
+      `plugin-primary-${PLUGIN_ID}:quick%23x`,
+      `plugin-primary-${PLUGIN_ID}:quick`,
+      `plugin-primary-${PLUGIN_ID}:quick#x`,
+    ]);
+    expect(new Set(keys).size).toBe(keys.length);
+  });
+
+  it("builds a key for a lone surrogate instead of throwing", () => {
+    // `encodeURIComponent` raises URIError here, and these keys are built
+    // during a card's render, where the board has no error boundary.
+    const lone = "\ud83c";
+    register(PLUGIN_ID, lone, "Lone surrogate");
+    register(PLUGIN_ID, "with-child", "Holder", () => [{ id: lone, label: "Child", run: vi.fn() }]);
+
+    const keys = allKeys();
+
+    expect(keys).toEqual([
