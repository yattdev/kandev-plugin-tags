+
+function isIconComponent(icon: unknown, depth: number): boolean {
+  try {
+    if (typeof icon === "function") return isRenderableFunction(icon);
+    if (!icon || typeof icon !== "object" || depth > MAX_ICON_WRAPPER_DEPTH) return false;
+    const tag = (icon as { $$typeof?: unknown }).$$typeof;
+    // Only the two tags that resolve synchronously, and only with a payload
+    // React would accept: the tag alone is something a plain object can carry.
+    if (tag === Symbol.for("react.memo")) {
+      return isIconComponent((icon as { type?: unknown }).type, depth + 1);
+    }
+    if (tag === Symbol.for("react.forward_ref")) {
+      return isRenderableFunction((icon as { render?: unknown }).render);
+    }
+    return false;
+  } catch {
+    return false;
   }
-  return false;
